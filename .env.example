# Reference only: launchers read process environment, not this file automatically.
# PowerShell: $env:PRAHARI_POLICY = "review-first"
# Bash: export PRAHARI_POLICY=review-first
PRAHARI_POLICY=review-first
PRAHARI_REVIEW_THRESHOLD=30
# PRAHARI_DB=/absolute/path/to/prahari.db
# PRAHARI_MODELS_DIR=/absolute/path/to/trusted/models
# For the optional Node adapter only; run_demo.py creates a fresh key automatically.
# PRAHARI_INTEGRATION_KEY=<generate-a-random-key>
PRAHARI_MODE=enforce
PRAHARI_URL=http://127.0.0.1:8000
DEMO_PORT=3000
