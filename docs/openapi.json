  "components": {
    "schemas": {
      "EnforcementEvent": {
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{1,64}$",
            "title": "Event Id"
          },
          "scan_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Scan Id"
          },
          "mode": {
            "type": "string",
            "enum": [
              "monitor",
              "enforce"
            ],
            "title": "Mode"
          },
          "action": {
            "type": "string",
            "enum": [
              "allowed",
              "blocked",
              "held"
            ],
            "title": "Action"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "scan_id",
          "mode",
          "action"
        ],
        "title": "EnforcementEvent"
      },
      "Finding": {
        "properties": {
          "detector": {
            "type": "string",
            "title": "Detector"
          },
          "category": {
            "type": "string",
            "enum": [
              "phishing",
              "sqli",
              "xss",
              "command_injection",
              "path_traversal"
            ],
            "title": "Category"
          },
          "evidence_kind": {
            "type": "string",
            "enum": [
              "rule",
              "model"
            ],
            "title": "Evidence Kind"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "score": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "component": {
            "type": "string",
            "title": "Component"
          },
          "rule_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rule Id"
          },
          "excerpt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Excerpt"
          },
          "view": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "View"
          },
          "start": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          },
          "end": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "End"
          },
          "transformations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Transformations"
          }
        },
        "type": "object",
        "required": [
          "detector",
          "category",
          "evidence_kind",
          "summary",
          "score",
          "component"
        ],
        "title": "Finding"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IncidentReview": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "open",
              "investigating",
              "resolved",
              "false_positive"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "IncidentReview"
      },
      "PolicyInput": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "review-first",
              "protect"
            ],
            "title": "Mode"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "PolicyInput"
      },
      "ReviewInput": {
        "properties": {
          "verdict": {
            "type": "string",
            "enum": [
              "benign",
              "malicious",
              "uncertain"
            ],
            "title": "Verdict"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "verdict"
        ],
        "title": "ReviewInput"
      },
      "ScanInput": {
        "properties": {
          "input_type": {
            "type": "string",
            "enum": [
              "url",
              "http_request",
              "payload"
            ],
            "title": "Input Type"
          },
          "content": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Content"
          },
          "content_type": {
            "type": "string",
            "enum": [
              "text/plain",
              "application/json",
              "application/x-www-form-urlencoded"
            ],
            "title": "Content Type",
            "default": "text/plain"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "input_type",
          "content"
        ],
        "title": "ScanInput"
      },
      "ScanResult": {
        "properties": {
          "scan_id": {
            "type": "string",
            "title": "Scan Id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "partial"
            ],
            "title": "Status"
          },
          "decision": {
            "type": "string",
            "enum": [
              "Allow",
              "Review",
              "Block"
            ],
            "title": "Decision"
          },
          "risk_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk Score"
          },
          "risk_kind": {
            "type": "string",
            "title": "Risk Kind",
            "default": "experimental_policy_index"
          },
          "action_taken": {
            "type": "string",
            "title": "Action Taken",
            "default": "none"
          },
          "review": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Review"
          },
          "enforcement_events": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Enforcement Events"
          },
          "category_scores": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Category Scores"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "title": "Findings"
          },
          "coverage": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Coverage"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          },
          "model_signals": {
            "additionalProperties": true,
            "type": "object",
            "title": "Model Signals"
          },
          "versions": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Versions"
          },
          "analysis_ms": {
            "type": "number",
            "title": "Analysis Ms"
          }
        },
        "type": "object",
        "required": [
          "scan_id",
          "created_at",
          "status",
          "decision",
          "risk_score",
          "category_scores",
          "findings",
          "coverage",
          "reasons",
          "model_signals",
          "versions",
          "analysis_ms"
        ],
        "title": "ScanResult"
      },
      "TelemetryEvent": {
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,128}$",
            "title": "Event Id"
          },
          "sensor_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "title": "Sensor Id"
          },
          "stream_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "title": "Stream Id",
            "default": "live"
          },
          "mode": {
            "type": "string",
            "enum": [
              "live",
              "replay"
            ],
            "title": "Mode",
            "default": "live"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          },
          "kind": {
            "type": "string",
            "enum": [
              "http",
              "flow"
            ],
            "title": "Kind"
          },
          "actor_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Actor Id"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "route": {
            "type": "string",
            "maxLength": 256,
            "title": "Route",
            "default": "/"
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "HEAD",
              "OPTIONS"
            ],
            "title": "Method",
            "default": "GET"
          },
          "status_code": {
            "type": "integer",
            "maximum": 599.0,
            "minimum": 100.0,
            "title": "Status Code",
            "default": 200
          },
          "auth_failed": {
            "type": "boolean",
            "title": "Auth Failed",
            "default": false
          },
          "scan_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scan Id"
          },
          "destination": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Destination"
          },
          "destination_port": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 65535.0,
                "minimum": 0.0
