{
  "openapi": "3.1.0",
  "info": {
    "title": "Prahari",
    "description": "Unified experimental web threat analysis. Local development API; decisions are advisory.",
    "version": "0.3.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/config": {
      "get": {
        "summary": "Config",
        "operationId": "config_api_v1_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/scans": {
      "post": {
        "summary": "Scan",
        "operationId": "scan_api_v1_scans_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "History",
        "operationId": "history_api_v1_scans_get",
        "parameters": [
          {
            "name": "decision",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "Allow",
                    "Review",
                    "Block"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Decision"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/enforcement-events": {
      "post": {
        "summary": "Event",
        "operationId": "event_api_v1_enforcement_events_post",
        "parameters": [
          {
            "name": "x-prahari-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Prahari-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnforcementEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scans/{scan_id}": {
      "get": {
        "summary": "Detail",
        "operationId": "detail_api_v1_scans__scan_id__get",
        "parameters": [
          {
            "name": "scan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Scan Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/dashboard/summary": {
      "get": {
        "summary": "Summary",
        "operationId": "summary_api_v1_dashboard_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EnforcementEvent": {
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{1,64}$",
            "title": "Event Id"
          },
          "scan_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Scan Id"
          },
          "mode": {
            "type": "string",
            "enum": [
              "monitor",
              "enforce"
            ],
            "title": "Mode"
          },
          "action": {
            "type": "string",
            "enum": [
              "allowed",
              "blocked",
              "held"
            ],
            "title": "Action"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "scan_id",
          "mode",
          "action"
        ],
        "title": "EnforcementEvent"
      },
      "Finding": {
        "properties": {
          "detector": {
            "type": "string",
            "title": "Detector"
          },
          "category": {
            "type": "string",
            "enum": [
              "phishing",
              "sqli",
              "xss",
              "command_injection",
              "path_traversal"
            ],
            "title": "Category"
          },
          "evidence_kind": {
            "type": "string",
            "enum": [
              "rule",
              "model"
            ],
            "title": "Evidence Kind"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "score": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "component": {
            "type": "string",
            "title": "Component"
          },
          "rule_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rule Id"
          },
          "view": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "View"
          },
          "start": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          },
          "end": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "End"
          },
          "transformations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Transformations"
          }
        },
        "type": "object",
        "required": [
          "detector",
          "category",
          "evidence_kind",
          "summary",
          "score",
          "component"
        ],
        "title": "Finding"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ScanInput": {
        "properties": {
          "input_type": {
            "type": "string",
            "enum": [
              "url",
              "http_request",
              "payload"
            ],
            "title": "Input Type"
          },
          "content": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Content"
          },
          "content_type": {
            "type": "string",
            "enum": [
              "text/plain",
              "application/json",
              "application/x-www-form-urlencoded"
            ],
            "title": "Content Type",
            "default": "text/plain"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "input_type",
          "content"
        ],
        "title": "ScanInput"
      },
      "ScanResult": {
        "properties": {
          "scan_id": {
            "type": "string",
            "title": "Scan Id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "partial"
            ],
            "title": "Status"
          },
          "decision": {
            "type": "string",
            "enum": [
              "Allow",
              "Review",
              "Block"
            ],
            "title": "Decision"
          },
          "risk_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk Score"
          },
          "risk_kind": {
            "type": "string",
            "title": "Risk Kind",
            "default": "experimental_policy_index"
          },
          "action_taken": {
            "type": "string",
            "title": "Action Taken",
            "default": "none"
          },
          "enforcement_events": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Enforcement Events"
          },
          "category_scores": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Category Scores"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "title": "Findings"
          },
          "coverage": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Coverage"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          },
          "model_signals": {
            "additionalProperties": true,
            "type": "object",
            "title": "Model Signals"
          },
          "versions": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Versions"
          },
          "analysis_ms": {
            "type": "number",
            "title": "Analysis Ms"
          }
        },
        "type": "object",
        "required": [
          "scan_id",
          "created_at",
          "status",
          "decision",
          "risk_score",
          "category_scores",
          "findings",
          "coverage",
          "reasons",
          "model_signals",
          "versions",
          "analysis_ms"
        ],
        "title": "ScanResult"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
